# Escrowrail — environment configuration.
# Backend: Spring Boot reads env vars directly (no .env file).
# Frontend: Vite reads VITE_* vars from .env files or the environment.

# --- Backend (backend-java) ---

# JDBC URL. Local dev uses docker-compose Postgres; prod uses Supabase
# with sslmode=require.
DATABASE_URL=jdbc:postgresql://localhost:5432/escrowrail_escrow
DATABASE_USER=escrowrail
DATABASE_PASSWORD=escrowrail

# In prod (SPRING_PROFILES_ACTIVE=prod) use the SPRING_DATASOURCE_* names:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=...
# SPRING_DATASOURCE_PASSWORD=...

# JWT HS256 signing secret. REQUIRED — must be >= 32 bytes; the app
# refuses to boot without it.
JWT_SECRET=

# AES-256 field-encryption key (base64, 32 bytes) for tax IDs and webhook
# secrets at rest. REQUIRED in prod — a public dev-only default is used
# otherwise.
ESCROWRAIL_FIELD_ENCRYPTION_KEY=

# HMAC secret verifying X-Hub-Signature-256 on settlement webhooks.
# REQUIRED in any environment that accepts real deliveries — a blank
# secret disables that webhook path entirely.
ESCROWRAIL_GITHUB_WEBHOOK_SECRET=
ESCROWRAIL_LOGISTICS_WEBHOOK_SECRET=

# Comma-separated SPA origins allowed by CORS (Vercel URL in prod).
ESCROWRAIL_CORS_ORIGINS=http://localhost:5173

# Demo tooling is PROFILE-gated, not flag-gated:
#  - SPRING_PROFILES_ACTIVE=prod  → no seed runner, no /api/v1/demo/**, no
#    /dev/**, mock webhooks refused. This is what Azure runs.
#  - SPRING_PROFILES_ACTIVE=demo  → pitch deployments: seeded tenants,
#    sandbox top-ups, signed webhook simulation.
#  - dev/test                    → plus the /dev verification-token
#    backdoor for local/E2E use.
# Optional knobs inside the demo profile:
ESCROWRAIL_SEED_PASSWORD=EscrowDemo123!
# Extra-hard gate on the server-side webhook simulator (demo profile sets
# it true; here for explicit opt-ins only).
# ESCROWRAIL_ALLOW_MOCK_WEBHOOKS=false

# --- Frontend (frontend/) ---

# Public backend URL. Set to the deployed backend on Vercel.
VITE_API_BASE_URL=http://localhost:8080
# Build-time demo tooling flag — see frontend/.env.* mode files.
VITE_ENABLE_DEMO_TOOLS=true
