# Wise Smart Escrow — environment configuration.
# Copy to .env for local overrides. All keys have safe defaults and
# the app runs correctly when .env is absent.

# SQLAlchemy database URL. SQLite by default; use a postgresql:// URL
# in deployment to enable the pooled engine (pool_size=20).
DATABASE_URL=sqlite:///./wise_escrow.db

# JWT signing secret for tenant access tokens. REQUIRED in any real
# deployment — the bundled default is dev-only and insecure.
JWT_SECRET=
# JWT algorithm + access-token lifetime (minutes).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Logging level for the app loggers (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# HMAC secret for verifying X-Hub-Signature-256 on GitHub webhooks.
# If unset, signature verification is skipped (local dev / demo only).
WISE_GITHUB_WEBHOOK_SECRET=

# Set to 1 to pull live spot rates from the Frankfurter API with a
# static-table fallback. Unset = always use the static table.
WISE_FX_LIVE=

# Timeout (seconds) for the live FX fetch.
WISE_FX_TIMEOUT=2.0

# Frankfurter API base URL.
WISE_FRANKFURTER_URL=https://api.frankfurter.dev/v1

# Informational ECB reference base rate (%) — reserved for future
# yield/disclosure features. Not used in settlement math.
ECB_BASE_RATE=4.50
